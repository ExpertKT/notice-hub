page { background: #f4f7fa; color: #172b45; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 32rpx; line-height: 1.55; }
view, text, button, input, textarea { box-sizing: border-box; }
.page { padding: 32rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); }
.top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; gap: 16rpx; }
.title { font-size: 48rpx; font-weight: 650; line-height: 1.25; }
.subtitle, .hint { color: #526176; font-size: 28rpx; }
.subtitle { margin-top: 12rpx; }
button { margin: 0; font: inherit; border-radius: 12rpx; min-height: 88rpx; padding: 18rpx 28rpx; line-height: 1.5; background: #e8eef7; color: #2155a3; }
button::after { border: 0; }
button[disabled] { background: #e2e7ee; color: #67748a; }
.primary { background: #2155a3; color: #fff; }
.small { font-size: 28rpx; padding: 16rpx 20rpx; flex-shrink: 0; }
.actions { display: flex; gap: 16rpx; flex-wrap: wrap; margin-top: 24rpx; }
.panel { background: #fff; border: 1rpx solid #dbe3ec; border-radius: 18rpx; padding: 28rpx; margin-bottom: 28rpx; }
.error { background: #fff3ef; color: #862f1a; border-color: #e9c9be; }
.error-title { font-weight: 600; }
.error-copy { font-size: 28rpx; margin-top: 12rpx; }
.empty { padding: 56rpx 8rpx; color: #526176; }
.section-title { font-size: 34rpx; font-weight: 600; margin: 32rpx 0 12rpx; }
.tag { display: inline-block; font-size: 24rpx; background: #e8eef7; color: #2155a3; padding: 4rpx 12rpx; border-radius: 8rpx; }
input, textarea { width: 100%; background: #fff; border: 2rpx solid #bbc8d8; border-radius: 12rpx; padding: 22rpx; color: #172b45; font-size: 32rpx; }
input { height: 96rpx; }
label { display: block; margin: 28rpx 0 12rpx; font-weight: 600; }
