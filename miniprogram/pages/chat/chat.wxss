.page { padding-bottom: calc(520rpx + env(safe-area-inset-bottom)); }
.intro { border-left: 4rpx solid #7B8B5E; padding: 8rpx 0 8rpx 22rpx; margin: 40rpx 0; }
.intro .hint { margin-top: 14rpx; }
.message { padding: 16rpx 24rpx; margin-bottom: 24rpx; white-space: pre-wrap; overflow-wrap: break-word; }
.user { width: fit-content; max-width: 90%; margin-left: auto; background: rgba(123,139,94,.14); border-radius: 24rpx; text-align: right; }
.assistant { padding-left: 0; padding-right: 0; color: #3A3A28; }
.speaker { font-size: 24rpx; color: #5A5744; margin-bottom: 10rpx; }
.steps { margin-top: 16rpx; padding: 14rpx 18rpx; border: 1rpx dashed rgba(58,58,40,.30); border-radius: 12rpx; font-size: 24rpx; line-height: 1.5; color: #5A5744; font-family: "SF Mono", Menlo, Consolas, monospace; }
.steps view + view { margin-top: 6rpx; }
.composer { position: fixed; z-index: 5; left: 32rpx; right: 32rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); padding: 24rpx; background: #FBF8F0; border: 1rpx solid rgba(58,58,40,.16); border-radius: 20rpx; box-shadow: 0 8rpx 28rpx rgba(58,58,40,.12); }
.composer label { margin: 0 0 12rpx; font-size: 26rpx; font-weight: 400; color: #5A5744; }
.composer .hint { margin-top: 12rpx; font-size: 24rpx; }
.composer .actions { margin-top: 16rpx; }
.composer .primary { flex: 1; }
textarea { min-height: 112rpx; max-height: 220rpx; }
@media (prefers-color-scheme: dark) {
  .intro { border-left-color: #97A878; }
  .user { background: rgba(151,168,120,.16); }
  .assistant { color: #EDE6D2; }
  .speaker, .composer label { color: #C3BCA4; }
  .steps { border-color: rgba(237,230,210,.24); color: #C3BCA4; }
  .composer { background: #2B2B21; border-color: rgba(237,230,210,.14); }
}
